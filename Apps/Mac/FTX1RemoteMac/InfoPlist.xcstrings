    "NSLocalNetworkUsageDescription" : {
      "comment" : "Local Network permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1 Remote muss Verbindungen von iPhone/iPad annehmen, um das Funkgerät fernzusteuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1 Remote needs to accept connections from your iPhone/iPad to control the radio remotely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1 Remote necesita aceptar conexiones del iPhone/iPad para controlar el equipo a distancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1 Remote doit accepter les connexions de l'iPhone/iPad pour commander le poste à distance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1 Remote deve accettare connessioni da iPhone/iPad per controllare l'apparato a distanza."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Microphone permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1 Remote nutzt das Audio des gewählten Eingabegeräts, um einen Wasserfall des Empfangsaudios zu zeichnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1 Remote uses audio from the selected input device to draw a waterfall display of receive audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1 Remote usa el audio del dispositivo de entrada seleccionado para dibujar una cascada del audio recibido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1 Remote utilise l'audio du périphérique d'entrée choisi pour dessiner une cascade de l'audio reçu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1 Remote usa l'audio del dispositivo di ingresso selezionato per disegnare una cascata dell'audio ricevuto."
          }
        }
      }
    },
