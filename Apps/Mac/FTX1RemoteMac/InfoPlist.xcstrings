    "NSLocalNetworkUsageDescription" : {
      "comment" : "Local Network permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1 Remote muss Verbindungen von iPhone/iPad annehmen, um das Funkgerät fernzusteuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1 Remote needs to accept connections from your iPhone/iPad to control the radio remotely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1 Remote necesita aceptar conexiones del iPhone/iPad para controlar el equipo a distancia."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Microphone permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1 Remote nutzt das Audio des gewählten Eingabegeräts, um einen Wasserfall des Empfangsaudios zu zeichnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1 Remote uses audio from the selected input device to draw a waterfall display of receive audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1 Remote usa el audio del dispositivo de entrada seleccionado para dibujar una cascada del audio recibido."
          }
        }
      }
    }
