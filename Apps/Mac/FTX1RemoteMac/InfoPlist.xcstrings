    "NSAudioCaptureUsageDescription" : {
      "comment" : "System Audio Recording permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1Remote nimmt auf, was das WebSDR-Fenster abspielt, damit das CW-Fenster es dekodieren kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1Remote captures what the WebSDR window is playing so the CW window can decode it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1Remote capta lo que reproduce la ventana WebSDR para que la ventana CW pueda decodificarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1Remote capte ce que joue la fenêtre WebSDR pour que la fenêtre CW puisse le décoder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FTX1Remote cattura ciò che la finestra WebSDR riproduce, così la finestra CW può decodificarlo."
          }
        }
      }
    },
