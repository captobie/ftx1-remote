    "localSDR.receiver.noiseBlankerHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Störaustaster im Kiwi für kurze Impulse wie Zündfunken oder Netzstörungen. Er wirkt auch auf den Wasserfall."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noise blanker on the Kiwi, for short impulses such as ignition or power-line noise. It applies to the waterfall too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supresor de ruido en el Kiwi, para impulsos cortos como encendidos o ruido de la red. También se aplica a la cascada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noise blanker sur le Kiwi, pour les impulsions brèves comme les parasites d'allumage ou du secteur. S'applique aussi à la cascade."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noise blanker sul Kiwi, per impulsi brevi come accensioni o disturbi della linea elettrica. Si applica anche alla cascata."
          }
        }
      }
    },
