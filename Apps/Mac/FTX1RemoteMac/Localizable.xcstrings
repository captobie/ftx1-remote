    "settings.rigctld.whenOffPttMox" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aus, sind PTT, MOX, Antennenabstimmung und CW-MESSAGE-Wiedergabe für jeden verbundenen Client gesperrt. Gilt sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, PTT, MOX, antenna tuning, and CW MESSAGE playback are disabled for every connected client. Applies immediately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado, PTT, MOX, la sintonía de antena y la reproducción de CW MESSAGE quedan bloqueados para todos los clientes conectados. Se aplica de inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé, le PTT, le MOX, l'accord d'antenne et la lecture de CW MESSAGE sont bloqués pour tous les clients connectés. S'applique immédiatement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se disattivato, PTT, MOX, accordo d'antenna e riproduzione di CW MESSAGE sono bloccati per tutti i client connessi. Si applica subito."
          }
        }
      }
    },
