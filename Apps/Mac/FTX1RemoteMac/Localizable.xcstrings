    "digiSendPane.macrosHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platzhalter: {MYCALL} und {MYGRID} (Einstellungen → Station), {CALL} (Gegenstation). {TX} am Anfang tastet das Gerät; {RX} am Ende schaltet auf Empfang zurück, sobald der Text gesendet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placeholders: {MYCALL} and {MYGRID} (Settings → Station), {CALL} (Their call). {TX} at the start keys the rig; {RX} at the end returns to receive once the text has gone out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcadores: {MYCALL} y {MYGRID} (Ajustes → Estación), {CALL} (Corresponsal). {TX} al principio activa la transmisión; {RX} al final vuelve a recepción cuando se ha enviado el texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marqueurs : {MYCALL} et {MYGRID} (Réglages → Station), {CALL} (Correspondant). {TX} au début passe le poste en émission ; {RX} à la fin revient en réception une fois le texte envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnaposto: {MYCALL} e {MYGRID} (Impostazioni → Stazione), {CALL} (Corrispondente). {TX} all'inizio manda in trasmissione l'apparato; {RX} alla fine torna in ricezione quando il testo è stato inviato."
          }
        }
      }
    },
