          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rigctld n'est pas lancé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rigctld non è in esecuzione."
          }
        }
      }
    },
    "connectionProblem.rigctldNotRunning.advice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am rigctld-Port dieses Macs lauscht nichts. Einstellungen → rigctld prüfen, dann trennen und neu verbinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing listens on rigctld's port on this Mac. Check Settings → rigctld, then Disconnect and Connect again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada escucha en el puerto de rigctld en este Mac. Comprobar Ajustes → rigctld y luego desconectar y volver a conectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n'écoute sur le port de rigctld sur ce Mac. Vérifier Réglages → rigctld, puis déconnecter et reconnecter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno è in ascolto sulla porta di rigctld su questo Mac. Controllare Impostazioni → rigctld, poi disconnettere e riconnettere."
          }
        }
      }
    },
    "connectionProblem.rigctldNotRunningOn %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist erreichbar, aber rigctld läuft dort nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is up, but rigctld isn't running on it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ responde, pero rigctld no está en marcha en ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ répond, mais rigctld n'y est pas lancé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è raggiungibile, ma rigctld non è in esecuzione."
          }
        }
      }
    },
    "connectionProblem.rigctldNotRunningOn.advice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Rechner antwortet, aber an Port 4532 lauscht nichts. Auf dem Pi: sudo systemctl restart rigctld, dann journalctl -u rigctld für den Grund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The computer answers, but nothing listens on port 4532. On the Pi: sudo systemctl restart rigctld, then journalctl -u rigctld to see why it stopped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ordenador responde, pero nada escucha en el puerto 4532. En la Pi: sudo systemctl restart rigctld y luego journalctl -u rigctld para ver por qué se detuvo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ordinateur répond, mais rien n'écoute sur le port 4532. Sur le Pi : sudo systemctl restart rigctld, puis journalctl -u rigctld pour voir pourquoi il s'est arrêté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il computer risponde, ma nessuno è in ascolto sulla porta 4532. Sul Pi: sudo systemctl restart rigctld, poi journalctl -u rigctld per vedere perché si è fermato."
          }
        }
      }
    },
