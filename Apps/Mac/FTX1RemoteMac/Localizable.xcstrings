    "%@ · %@" : {
      "comment" : "A subheading displaying the date and duration of a recording. The first argument is the date and time of the recording. The second argument is the string “%1$d:%2$02d”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ (%@)" : {
      "comment" : "A line that shows the tuning event's text and timestamp. The first argument is the event's text. The second argument is the event's timestamp.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ (MHz)" : {
      "comment" : "A text field for entering a band's home frequency in MHz. The argument is the band's display name.",
      "isCommentAutoGenerated" : true
    },
    "%@ MHz" : {
      "comment" : "A label that says \"Logged from the transmitting side\".",
      "isCommentAutoGenerated" : true
    },
    "%@%@" : {
      "comment" : "The text is a concatenation of the linked text and the tentative text, with the tentative text in a tertiary color.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@%2$@"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A column showing the signal-to-noise ratio (SNR) of an FT8 message.",
      "isCommentAutoGenerated" : true
    },
    "%lld dB" : {
      "comment" : "A column showing the signal-to-noise ratio (SNR) of a KiwiSDR station.",
      "isCommentAutoGenerated" : true
    },
    "%lld km" : {
      "comment" : "A column showing the distance of a KiwiSDR station in kilometers.",
      "isCommentAutoGenerated" : true
    },
    "%lld W" : {
      "comment" : "A label that displays the RF power level of the transmitting rig.",
      "isCommentAutoGenerated" : true
    },
    "%lld WPM" : {
      "comment" : "A label that displays the speed of the rig's keyer. The argument is the speed of the rig's keyer.",
      "isCommentAutoGenerated" : true
    },
    "%lld/%lld" : {
      "comment" : "A sublabel that displays the current chunk number out of the total number of chunks for a chunked item. The first argument is the current chunk number. The second argument is the total number of chunks.",
