    "settings.audioSettings.localModeWhereAn" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokaler Modus: wo das PTT-Mikrofon eines iPad abgespielt wird – das USB-Audiogerät des FTX-1 wählen. Im Fernmodus geht es stattdessen an den Pi. Gilt ab dem nächsten Senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local mode: where an iPad's PTT microphone is played — pick the FTX-1's USB audio device. Remote mode sends it to the Pi instead. Takes effect on the next transmission."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo local: dónde se reproduce el micrófono PTT de un iPad; elegir el dispositivo de audio USB del FTX-1. En modo remoto se envía al Pi. Se aplica en la próxima transmisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode local : où est joué le micro PTT d'un iPad ; choisir le périphérique audio USB du FTX-1. En mode distant, il est plutôt envoyé au Pi. Prend effet à la prochaine émission."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo locale: dove viene riprodotto il microfono PTT di un iPad; scegliere il dispositivo audio USB dell'FTX-1. In modo remoto viene invece inviato al Pi. Ha effetto alla trasmissione successiva."
          }
        }
      }
    },
