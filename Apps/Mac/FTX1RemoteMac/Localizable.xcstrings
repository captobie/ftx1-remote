    "localSDR.passband.resetHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurück zum Standard-Durchlassbereich dieser Betriebsart"
          }
