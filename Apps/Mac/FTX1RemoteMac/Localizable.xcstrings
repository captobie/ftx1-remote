    "connectionProblem.hostNotFound %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nicht gefunden. Ist Tailscale auf diesem Mac verbunden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't find %@. Is Tailscale connected on this Mac?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encuentra %@. ¿Está Tailscale conectado en este Mac?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ introuvable. Tailscale est-il connecté sur ce Mac ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile trovare %@. Tailscale è connesso su questo Mac?"
          }
        }
      }
    },
    "connectionProblem.hostNotFound.advice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Name lässt sich nicht auflösen. Prüfen, ob Tailscale auf diesem Mac verbunden ist, und den Hostnamen unter Einstellungen → rigctld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host name doesn't resolve. Check that Tailscale is connected on this Mac, and the host name in Settings → rigctld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre no se resuelve. Comprobar que Tailscale está conectado en este Mac y el nombre en Ajustes → rigctld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom d'hôte ne se résout pas. Vérifier que Tailscale est connecté sur ce Mac, ainsi que le nom d'hôte dans Réglages → rigctld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome host non si risolve. Verificare che Tailscale sia connesso su questo Mac e il nome host in Impostazioni → rigctld."
          }
        }
      }
    },
    "connectionProblem.hostUnreachable %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nicht erreichbar. Der Pi ist vielleicht aus oder nicht im Tailnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't reach %@. The Pi may be off or off the tailnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede contactar con %@. La Pi puede estar apagada o fuera de la tailnet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre %@. Le Pi est peut-être éteint ou hors du tailnet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere %@. Il Pi potrebbe essere spento o fuori dalla tailnet."
          }
        }
      }
    },
    "connectionProblem.hostUnreachable.advice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Rechner antwortet überhaupt nicht. Stromversorgung und Netzwerk prüfen, und ob Tailscale dort und auf diesem Mac verbunden ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No answer from that computer at all. Check its power and network, and that Tailscale is connected on it and on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese ordenador no responde en absoluto. Comprobar su alimentación y su red, y que Tailscale está conectado en él y en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune réponse de cet ordinateur. Vérifier son alimentation et son réseau, et que Tailscale est connecté sur lui et sur ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna risposta da quel computer. Controllarne alimentazione e rete, e che Tailscale sia connesso su di esso e su questo Mac."
          }
        }
      }
    },
    "connectionProblem.rigNotResponding" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rigctld läuft, aber das Funkgerät antwortet nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rigctld is running, but the radio isn't answering."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rigctld está en marcha, pero el equipo no responde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rigctld est lancé, mais le poste ne répond pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rigctld è in esecuzione, ma l'apparato non risponde."
          }
        }
      }
    },
    "connectionProblem.rigNotResponding.advice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stromversorgung des Geräts und sein USB-Kabel zu diesem Mac prüfen. Nach dem Neueinstecken trennen und neu verbinden, um rigctld neu zu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the radio's power and its USB cable to this Mac. If it was replugged, Disconnect and Connect again to restart rigctld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprobar la alimentación del equipo y su cable USB a este Mac. Si se volvió a enchufar, desconectar y conectar de nuevo para reiniciar rigctld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifier l'alimentation du poste et son câble USB vers ce Mac. S'il a été rebranché, déconnecter puis reconnecter pour redémarrer rigctld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controllare l'alimentazione dell'apparato e il suo cavo USB verso questo Mac. Se è stato ricollegato, disconnettere e riconnettere per riavviare rigctld."
          }
        }
      }
    },
    "connectionProblem.rigNotRespondingOn %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rigctld läuft auf %@, aber das Funkgerät antwortet nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rigctld on %@ is running, but the radio isn't answering."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rigctld está en marcha en %@, pero el equipo no responde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rigctld est lancé sur %@, mais le poste ne répond pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "rigctld su %@ è in esecuzione, ma l'apparato non risponde."
          }
        }
      }
    },
    "connectionProblem.rigNotRespondingOn.advice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stromversorgung des Geräts und sein USB-Kabel zum Pi prüfen. Unterspannung am Pi kann den USB-Anschluss des Geräts trennen: vcgencmd get_throttled sollte 0x0 zeigen. Gerät neu einstecken oder aus- und einschalten, dann rigctld auf dem Pi neu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the radio's power and its USB cable to the Pi. Pi under-voltage can drop the radio's USB: vcgencmd get_throttled should read 0x0. Replug or power-cycle the radio, then restart rigctld on the Pi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprobar la alimentación del equipo y su cable USB a la Pi. Una tensión baja en la Pi puede desconectar el USB del equipo: vcgencmd get_throttled debería indicar 0x0. Volver a enchufar o apagar y encender el equipo y reiniciar rigctld en la Pi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifier l'alimentation du poste et son câble USB vers le Pi. Une sous-tension du Pi peut faire tomber l'USB du poste : vcgencmd get_throttled doit indiquer 0x0. Rebrancher ou éteindre et rallumer le poste, puis redémarrer rigctld sur le Pi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controllare l'alimentazione dell'apparato e il suo cavo USB verso il Pi. Una sottotensione del Pi può far cadere l'USB dell'apparato: vcgencmd get_throttled dovrebbe indicare 0x0. Ricollegare o spegnere e riaccendere l'apparato, poi riavviare rigctld sul Pi."
          }
        }
      }
    },
    "connectionProblem.rigctldNotRunning" : {
      "extractionState" : "manual",
      "localizations" : {
