    "settings.audioSettings.squelchHangTimeHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange der Squelch der App nach dem Ende eines Signals offen bleibt. Kürzer schneidet das Rauschen früher ab; zu kurz kann bei lauter Sprache aussetzen. Gilt sofort für MAIN und SUB."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How long the app's squelch stays open after a signal ends. Shorter cuts the noise burst sooner; too short can drop out during loud speech. Applies to MAIN and SUB at once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto tiempo sigue abierto el squelch de la app cuando termina una señal. Más corto corta antes el ruido; demasiado corto puede cortar durante voz fuerte. Se aplica al instante a MAIN y SUB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée pendant laquelle le squelch de l'app reste ouvert après la fin d'un signal. Plus court coupe le souffle plus tôt ; trop court peut couper pendant une parole forte. S'applique aussitôt à MAIN et SUB."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per quanto tempo lo squelch dell'app resta aperto dopo la fine di un segnale. Più breve taglia prima il rumore; troppo breve può interrompere il parlato forte. Si applica subito a MAIN e SUB."
          }
        }
      }
    },
    "settings.audioSettings.transmitAudioOutput" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
