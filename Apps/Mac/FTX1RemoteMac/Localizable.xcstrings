    "straightKey.remoteModeThePis %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernmodus: Der Dienst ftx1-cwkey auf dem Pi tastet den zweiten USB-Port des Geräts und gibt das Timing dort wieder. Am Gerät CW SETTING → MODE CW → PC KEYING auf %@ stellen und RPTT SELECT dort auf OFF lassen. Eine Änderung entschärft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remote mode: the Pi's ftx1-cwkey service keys the rig's second USB port and plays your timing out there. On the rig set CW SETTING → MODE CW → PC KEYING to %@, and leave RPTT SELECT there OFF. Changing these disarms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo remoto: el servicio ftx1-cwkey del Pi manipula el segundo puerto USB del equipo y reproduce allí la temporización. En el equipo, poner CW SETTING → MODE CW → PC KEYING en %@ y dejar allí RPTT SELECT en OFF. Cambiar esto desarma."
          }
        }
      }
    },
