    "licenseSettingsTab.theRegionsAmateurAllocations" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Amateurfunkzuweisungen der Region als äußere Bandgrenzen, alle Betriebsarten erlaubt – nicht die Regeln eines Landes. In Eigene kopieren und an die eigene Lizenz anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The region's amateur allocations as outer band edges, every mode allowed — not any country's rules. Copy it to Custom and edit it to your license."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las atribuciones de radioaficionado de la región como límites exteriores de banda, con todos los modos permitidos; no son las normas de ningún país. Copiarlo a Personalizado y ajustarlo a la propia licencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les attributions amateur de la région comme limites extérieures de bande, tous modes autorisés : ce ne sont les règles d'aucun pays. La copier dans Personnalisé et l'adapter à sa licence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le assegnazioni radioamatoriali della regione come limiti esterni di banda, con ogni modo consentito: non sono le regole di alcun paese. Copiarla in Personalizzato e adattarla alla propria licenza."
          }
        }
      }
    },
