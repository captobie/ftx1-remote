    "settings.mobile.tailscaleExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale ist ein kostenloses VPN, mit dem das iPad diesen Mac von überall erreicht – zu Hause, im Mobilfunknetz oder in einem anderen WLAN –, ohne Ports am Router zu öffnen. Auf diesem Mac und dem iPad installieren und auf beiden mit demselben Konto anmelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale is a free VPN that lets the iPad reach this Mac from anywhere — at home, on cellular or on another Wi-Fi — without opening ports on your router. Install it on this Mac and the iPad, and sign in to the same account on both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale es una VPN gratuita que permite al iPad llegar a este Mac desde cualquier lugar (en casa, con datos móviles o en otra Wi-Fi) sin abrir puertos en el router. Instalarlo en este Mac y en el iPad, e iniciar sesión con la misma cuenta en ambos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale est un VPN gratuit qui permet à l'iPad de joindre ce Mac de partout (à la maison, en cellulaire ou sur un autre Wi-Fi) sans ouvrir de ports sur le routeur. L'installer sur ce Mac et sur l'iPad, et se connecter au même compte sur les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale è una VPN gratuita che permette all'iPad di raggiungere questo Mac da ovunque (a casa, su rete cellulare o su un'altra Wi-Fi) senza aprire porte sul router. Installarla su questo Mac e sull'iPad, e accedere con lo stesso account su entrambi."
          }
        }
      }
    },
