    "settings.mobile.sameNetworkNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese funktionieren nur, solange das iPad im selben WLAN oder Netzwerk wie dieser Mac ist, und die IP-Adresse kann sich ändern, wenn sich der Mac neu verbindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These work only while the iPad is on the same Wi-Fi or network as this Mac, and the IP address can change when the Mac reconnects."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo funcionan mientras el iPad está en la misma Wi-Fi o red que este Mac, y la dirección IP puede cambiar cuando el Mac se vuelve a conectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne fonctionnent que si l'iPad est sur le même Wi-Fi ou réseau que ce Mac, et l'adresse IP peut changer quand le Mac se reconnecte."
