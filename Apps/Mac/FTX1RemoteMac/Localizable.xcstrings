    "settings.wavelogSettings.theRadioWavelogShows" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Funkgerät, das Wavelog im QSO-Formular zeigt. Meldet WaveLogGate dieses Gerät ebenfalls, es beenden oder ihm einen anderen Namen geben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The radio Wavelog shows in its QSO form. If WaveLogGate also reports this rig, quit it or give it another name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El equipo que Wavelog muestra en su formulario de QSO. Si WaveLogGate también informa de este equipo, cerrarlo o darle otro nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La radio que Wavelog affiche dans son formulaire QSO. Si WaveLogGate signale aussi ce poste, le quitter ou lui donner un autre nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La radio che Wavelog mostra nel suo modulo QSO. Se anche WaveLogGate segnala questo apparato, chiuderlo o dargli un altro nome."
          }
        }
      }
    },
    "settings.wavelogSettings.thisLooksLikeAn" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sieht nach einem API-v1-Schlüssel aus. FTX1Remote verwendet API v2: auf der API-Seite von Wavelog ein Token (wl2_…) mit den Scopes qso:write und station:read (radio:write für CAT) erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This looks like an API v1 key. FTX1Remote uses API v2: create a token (wl2_…) with the qso:write and station:read scopes (radio:write for CAT) on Wavelog’s API page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece una clave de API v1. FTX1Remote usa la API v2: crear un token (wl2_…) con los ámbitos qso:write y station:read (radio:write para CAT) en la página API de Wavelog."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela ressemble à une clé API v1. FTX1Remote utilise l'API v2 : créer un jeton (wl2_…) avec les portées qso:write et station:read (radio:write pour le CAT) sur la page API de Wavelog."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra una chiave API v1. FTX1Remote usa l'API v2: creare un token (wl2_…) con gli ambiti qso:write e station:read (radio:write per CAT) nella pagina API di Wavelog."
          }
        }
      }
    },
