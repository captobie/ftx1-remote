    "settings.wavelogSettings.clickingASpotIn" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Klick auf einen Spot in Wavelog stimmt MAIN ab. Wavelog ruft diesen Mac über die CAT-URL seines Funkgeräts auf, http://127.0.0.1:54321, sofern dort nicht geändert – der Browser muss also auf diesem Mac laufen."
