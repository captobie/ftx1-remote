    "licenseSettingsTab.frequenciesApplyWhenYou" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequenzen gelten nach Return oder beim Verlassen des Felds. Ein Signal muss in Segmente passen, die seine Sendeart erlauben – Seitenbänder eingeschlossen (LSB reicht 2,9 kHz unter die Skalenfrequenz, FM ±8 kHz). Die Amateurfunkbänder bleiben die äußere Grenze."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequencies apply when you press Return or leave the field. A signal has to fit inside segments that allow its kind of emission — sidebands included (LSB reaches 2.9 kHz below the dial, FM ±8 kHz). The amateur bands stay the outer limit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las frecuencias se aplican al pulsar Intro o salir del campo. Una señal debe caber en segmentos que permitan su tipo de emisión, bandas laterales incluidas (LSB llega a 2,9 kHz por debajo del dial, FM ±8 kHz). Las bandas de radioaficionado siguen siendo el límite exterior."
          }
        }
      }
    },
