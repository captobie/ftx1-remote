    "licenseSettingsTab.47Cfr97301" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "47 CFR §97.301/§97.305, Stand Oktober 2026, kontinentale USA. 60 m sind die fünf Kanäle; 70 cm ist 420–450 MHz ohne den Ausschluss nach Line A."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "47 CFR §97.301/§97.305 as of October 2026, continental US. 60 m is the five channels; 70 cm is 420–450 MHz without the Line A exclusion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "47 CFR §97.301/§97.305 a octubre de 2026, EE. UU. continental. 60 m son los cinco canales; 70 cm es 420–450 MHz sin la exclusión de la Línea A."
          }
        }
      }
    },
    "licenseSettingsTab.addSegment" : {
      "extractionState" : "manual",
      "localizations" : {
