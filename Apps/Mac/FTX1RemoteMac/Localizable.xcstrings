    "localSDR.followRigWidthHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange „Gerät folgen“ an ist, die Filterbreite und den IF SHIFT von MAIN als Durchlassbereich verwenden. Ziehen des Durchlassbereichs schaltet dies aus. Es wartet, solange die Filterregler des Geräts auf SUB stehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While Follow rig is on, use MAIN's filter width and IF SHIFT as the passband. Dragging the passband turns this off. It waits while the rig's filter controls are on SUB."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras «Seguir al equipo» está activo, usar el ancho de filtro y el IF SHIFT de MAIN como banda de paso. Arrastrar la banda de paso lo desactiva. Espera mientras los controles de filtro del equipo están en SUB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant que « Suivre le poste » est activé, utiliser la largeur de filtre et l'IF SHIFT de MAIN comme bande passante. Faire glisser la bande passante le désactive. Attend tant que les commandes de filtre du poste sont sur SUB."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre «Segui l'apparato» è attivo, usa la larghezza del filtro e l'IF SHIFT di MAIN come banda passante. Trascinare la banda passante lo disattiva. Resta in attesa mentre i controlli del filtro dell'apparato sono su SUB."
          }
        }
      }
    },
    "localSDR.passband.readoutHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Durchlassbereich und seine Breite. Zum Ändern die Kanten im Wasserfall ziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The passband and its width. Drag its edges on the waterfall to change it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La banda de paso y su ancho. Arrastrar sus bordes en la cascada para cambiarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bande passante et sa largeur. Faire glisser ses bords sur la cascade pour la modifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La banda passante e la sua larghezza. Trascinarne i bordi sulla cascata per modificarla."
          }
        }
      }
    },
