    "straightKey.theKeyerRunsIn" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Keyer läuft im Tasten-Interface; diese Werte werden bei jeder Verbindung an es gesendet. Die Handtaste funktioniert parallel zum Paddle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The keyer runs in the key interface; these are sent to it whenever it connects. The straight key works alongside the paddle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El keyer funciona en la interfaz de llave; estos valores se le envían cada vez que se conecta. La llave vertical funciona junto con el paddle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le keyer tourne dans l'interface du manipulateur ; ces valeurs lui sont envoyées à chaque connexion. Le manipulateur droit fonctionne avec le paddle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il keyer funziona nell'interfaccia del tasto; questi valori le vengono inviati ogni volta che si connette. Il tasto verticale funziona insieme al paddle."
          }
        }
      }
    },
    "straightKey.theRigsSecondUsb %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der zweite USB-Port des Geräts („Standard COM Port“), nicht der von rigctld. Am Gerät CW SETTING → MODE CW → PC KEYING auf %@ stellen und RPTT SELECT dort auf OFF lassen. Eine Änderung entschärft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The rig's second USB port (\"Standard COM Port\"), not rigctld's. On the rig set CW SETTING → MODE CW → PC KEYING to %@, and leave RPTT SELECT there OFF. Changing these disarms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El segundo puerto USB del equipo («Standard COM Port»), no el de rigctld. En el equipo, poner CW SETTING → MODE CW → PC KEYING en %@ y dejar allí RPTT SELECT en OFF. Cambiar esto desarma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le second port USB du poste (« Standard COM Port »), pas celui de rigctld. Sur le poste, régler CW SETTING → MODE CW → PC KEYING sur %@ et y laisser RPTT SELECT sur OFF. Les modifier désarme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La seconda porta USB dell'apparato («Standard COM Port»), non quella di rigctld. Sull'apparato impostare CW SETTING → MODE CW → PC KEYING su %@ e lasciare lì RPTT SELECT su OFF. Modificarli disarma."
          }
        }
      }
    },
