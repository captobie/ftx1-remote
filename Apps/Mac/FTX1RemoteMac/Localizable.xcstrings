    "rigctldProcessController.theRigctldAlreadyRunning %u %@ %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das bereits auf Port %1$u laufende rigctld ist für %2$@, nicht für %3$@. Es beenden (oder das Programm, das es gestartet hat, z. B. WSJT-X), dann erneut verbinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The rigctld already running on port %u is for %@, not %@. Quit it (or the program that started it, e.g. WSJT-X), then connect again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rigctld que ya se ejecuta en el puerto %1$u es para %2$@, no para %3$@. Cerrarlo (o el programa que lo inició, p. ej., WSJT-X) y volver a conectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rigctld déjà lancé sur le port %1$u est pour %2$@, pas pour %3$@. Le quitter (ou le programme qui l'a lancé, p. ex. WSJT-X), puis se reconnecter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rigctld già in esecuzione sulla porta %1$u è per %2$@, non per %3$@. Chiuderlo (o il programma che l'ha avviato, ad es. WSJT-X), poi riconnettersi."
          }
        }
      }
    },
