    },
    "licenseSettingsTab.blocksPttMoxAntenna" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperrt PTT, MOX, Antennenabstimmung, CW-Senden und die CW-Taste – von diesem Mac und von jedem verbundenen Client –, außer das Signal der Sendeseite passt in seiner Betriebsart in diese Berechtigungen. Wird beim Senden aus ihnen heraus abgestimmt oder die Betriebsart gewechselt, wird das Gerät enttastet. Nur eine Schutzschranke: Für den Betrieb im Rahmen der eigenen Lizenz bleibt der Funkamateur verantwortlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocks PTT, MOX, antenna tuning, CW sending and the CW key — from this Mac and from every connected client — unless the transmitting side's signal fits inside these privileges, in its mode. Tuning or changing mode out of them while transmitting unkeys the rig. A guardrail only: you remain responsible for operating within your license."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea PTT, MOX, la sintonía de antena, el envío de CW y la llave CW, desde este Mac y desde todos los clientes conectados, salvo que la señal del lado que transmite quepa dentro de estos privilegios en su modo. Sintonizar o cambiar de modo fuera de ellos durante la transmisión desactiva la transmisión del equipo. Es solo una salvaguarda: la responsabilidad de operar dentro de la propia licencia sigue siendo del operador."
          }
        }
      }
    },
