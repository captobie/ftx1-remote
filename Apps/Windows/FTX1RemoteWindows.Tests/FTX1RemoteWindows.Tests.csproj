<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the hub's wire code (Apps/Windows/README.md, "Desktop hub for
    the iPad"). Compiles the files under test directly rather than
    referencing the WinUI app, so it builds and runs with a plain
    `dotnet test` — keep those files free of WinUI types.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>FTX1RemoteWindows.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\FTX1RemoteWindows\Services\Hub\WireModels.cs" Link="Linked\WireModels.cs" />
    <Compile Include="..\FTX1RemoteWindows\Services\Hub\HubAddressFilter.cs" Link="Linked\HubAddressFilter.cs" />
    <Compile Include="..\FTX1RemoteWindows\Services\Hub\RigCommandWire.cs" Link="Linked\RigCommandWire.cs" />
    <Compile Include="..\FTX1RemoteWindows\Services\Hub\HubCommandPolicy.cs" Link="Linked\HubCommandPolicy.cs" />
    <Compile Include="..\FTX1RemoteWindows\Services\Hub\HubAudioEncoder.cs" Link="Linked\HubAudioEncoder.cs" />
    <Compile Include="..\FTX1RemoteWindows\Services\Hub\HubListWire.cs" Link="Linked\HubListWire.cs" />
    <!-- The real server, on loopback, for the menu-read routing test; AppLog is a stub here (TestAppLog.cs) so tests don't write to the app's log. -->
    <Compile Include="..\FTX1RemoteWindows\Services\Hub\HubServer.cs" Link="Linked\HubServer.cs" />
    <!-- Phase 5: transmit audio state and the Pi sink. -->
    <Compile Include="..\FTX1RemoteWindows\Services\Hub\HubTransmitAudio.cs" Link="Linked\HubTransmitAudio.cs" />
    <Compile Include="..\FTX1RemoteWindows\Services\RemoteTxAudioClient.cs" Link="Linked\RemoteTxAudioClient.cs" />
    <!-- Phase 6: the CW keyer pair, write checks, keyer tracker and confirmed stop. -->
    <Compile Include="..\FTX1RemoteWindows\Services\Hub\HubKeyer.cs" Link="Linked\HubKeyer.cs" />
    <Compile Include="..\FTX1RemoteWindows\Models\MemoryChannelEntry.cs" Link="Linked\MemoryChannelEntry.cs" />
    <Compile Include="..\FTX1RemoteWindows\Models\AprsModels.cs" Link="Linked\AprsModels.cs" />
    <Compile Include="..\FTX1RemoteWindows\Services\TransmitGate.cs" Link="Linked\TransmitGate.cs" />
    <!-- Settings → License: the privilege model and presets behind the gate. -->
    <Compile Include="..\FTX1RemoteWindows\Models\TransmitPrivileges.cs" Link="Linked\TransmitPrivileges.cs" />
    <Compile Include="..\FTX1RemoteWindows\Models\PrivilegePresets.cs" Link="Linked\PrivilegePresets.cs" />
    <Compile Include="..\FTX1RemoteWindows\Models\RigDelayCode.cs" Link="Linked\RigDelayCode.cs" />
    <Compile Include="..\FTX1RemoteWindows\Models\RigState.cs" Link="Linked\RigState.cs" />
    <Compile Include="..\FTX1RemoteWindows\Models\RigMode.cs" Link="Linked\RigMode.cs" />
    <Compile Include="..\FTX1RemoteWindows\Models\BandPlan.cs" Link="Linked\BandPlan.cs" />
    <Compile Include="..\FTX1RemoteWindows\Models\MemoryScan.cs" Link="Linked\MemoryScan.cs" />
    <Compile Include="..\FTX1RemoteWindows\Models\FilterModels.cs" Link="Linked\FilterModels.cs" />
    <Compile Include="..\FTX1RemoteWindows\Models\MeterScale.cs" Link="Linked\MeterScale.cs" />
    <!-- FilterModels.cs's NarrowWidthPreset refers to the catalog, which needs the tone tables. -->
    <Compile Include="..\FTX1RemoteWindows\Models\DeepSettingsCatalog.cs" Link="Linked\DeepSettingsCatalog.cs" />
    <Compile Include="..\FTX1RemoteWindows\Models\RigToneTables.cs" Link="Linked\RigToneTables.cs" />
    <!-- Wavelog: the API client, the tune request parsing and the tune listener. -->
    <Compile Include="..\FTX1RemoteWindows\Services\Wavelog.cs" Link="Linked\Wavelog.cs" />
    <Compile Include="..\FTX1RemoteWindows\Services\WavelogTuneRequest.cs" Link="Linked\WavelogTuneRequest.cs" />
    <Compile Include="..\FTX1RemoteWindows\Services\WavelogTuneListener.cs" Link="Linked\WavelogTuneListener.cs" />
    <Compile Include="..\FTX1RemoteWindows\Models\LoggedQso.cs" Link="Linked\LoggedQso.cs" />
    <Compile Include="..\FTX1RemoteWindows\Models\ThemeDefinition.cs" Link="Linked\ThemeDefinition.cs" />
    <!-- The strings those files show (English only here; LocalizationTests reads all three .resx). -->
    <Compile Include="..\FTX1RemoteWindows\Localization\Loc.cs" Link="Linked\Loc.cs" />
    <EmbeddedResource Include="..\FTX1RemoteWindows\Localization\Strings.resx" Link="Linked\Strings.resx" LogicalName="FTX1RemoteWindows.Localization.Strings.resources" />
  </ItemGroup>

  <ItemGroup>
    <!-- HubServer runs on Kestrel. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- HubAudioEncoder uses its WdlResampler; same version as the app. -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

</Project>
