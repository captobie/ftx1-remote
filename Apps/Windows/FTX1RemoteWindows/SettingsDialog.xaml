<Window
    x:Class="FTX1RemoteWindows.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">

    <!-- The Mac's Settings tabs (SettingsView.swift), with its Updates tab
         folded into About (notify-only, no Sparkle on Windows); Station has the callsign (CW macros) and
         grid square (the WebSDR station list's distances, CW macros). Everything applies on Save; Cancel discards
         every tab, unlike the Mac, where only the rigctld tab waits. A resizable modal window, not a
         ContentDialog, which can't be resized and clipped the wider tabs. -->
    <Grid x:Name="RootGrid" Padding="24,16,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <SelectorBar x:Name="TabBar" SelectionChanged="TabBar_SelectionChanged">
            <SelectorBarItem Text="rigctld" Tag="Rigctld" IsSelected="True" />
            <SelectorBarItem Text="Audio" Tag="Audio" />
            <SelectorBarItem Text="C4FM" Tag="C4fm" />
            <SelectorBarItem Text="APRS" Tag="Aprs" />
            <SelectorBarItem Text="Station" Tag="Station" />
            <SelectorBarItem Text="Logbook" Tag="Logbook" />
            <SelectorBarItem Text="Home Freq" Tag="Home" />
            <SelectorBarItem Text="Polling" Tag="Polling" />
            <SelectorBarItem Text="Appearance" Tag="Appearance" />
            <SelectorBarItem Text="Hub" Tag="Hub" />
            <SelectorBarItem Text="About" Tag="About" />
        </SelectorBar>

        <ScrollViewer Grid.Row="1" Padding="0,0,16,0">
            <Grid>
                <!-- rigctld -->
                <StackPanel x:Name="RigctldTab" Spacing="12">
                    <TextBlock x:Name="ConnectedNote" Visibility="Collapsed" TextWrapping="Wrap" Foreground="DarkOrange"
                               Text="Disconnect to change the connection settings." />
                    <ComboBox x:Name="ConnectionModeComboBox" Header="Connection" Width="260" HorizontalAlignment="Left"
                              SelectionChanged="ConnectionModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Remote (Pi over Tailscale)" Tag="Remote" />
                        <ComboBoxItem Content="Local (USB on this PC)" Tag="Local" />
                    </ComboBox>

                    <StackPanel x:Name="RemoteSettingsPanel" Spacing="12">
                        <TextBox x:Name="PiHostBox" Header="Pi hostname" Width="320" HorizontalAlignment="Left"
                                 PlaceholderText="e.g. ftx1-pi (Tailscale MagicDNS name)" />
                        <TextBlock Text="rigctld on the Pi, port 4532." Foreground="Gray" FontSize="12" />
                    </StackPanel>

                    <StackPanel x:Name="LocalSettingsPanel" Spacing="12" Visibility="Collapsed">
                        <!-- Filled in code: Automatic, Built-in, the installed copies found, Browse…. -->
                        <ComboBox x:Name="RigctldChoiceComboBox" Header="rigctld.exe" Width="560" HorizontalAlignment="Left"
                                  SelectionChanged="RigctldChoiceComboBox_SelectionChanged"
                                  ToolTipService.ToolTip="Automatic uses an installed Hamlib 4.7 or later that knows the rig, else the copy built into the app." />
                        <NumberBox x:Name="ModelNumberBox" Header="Model number" Width="160" HorizontalAlignment="Left"
                                   Minimum="1" Maximum="99999" SmallChange="1" LargeChange="1"
                                   ToolTipService.ToolTip="hamlib's rig model — 1051 is the FTX-1" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <ComboBox x:Name="ComPortComboBox" Header="COM port" Width="140" HorizontalAlignment="Left" IsEditable="True"
                                      PlaceholderText="COM3" DropDownOpened="ComPortComboBox_DropDownOpened"
                                      ToolTipService.ToolTip="The FTX-1's CAT port (the Enhanced COM port of its CP210x pair)" />
                            <ComboBox x:Name="BaudRateComboBox" Header="Baud rate" Width="140" HorizontalAlignment="Left" />
                        </StackPanel>
                        <TextBlock Text="rigctld is started on 127.0.0.1:4532 (or an already-running one is used), so WSJT-X's &quot;Hamlib NET rigctl&quot; can share it."
                                   Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- The Mac's RigctldVersionBox: follows the fields above (unsaved). -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Version" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="4" Padding="12,8">
                            <Grid ColumnSpacing="12" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="InstalledVersionLabel" Text="Uses" />
                                <StackPanel x:Name="InstalledVersionPanel" Grid.Column="1" Spacing="4">
                                    <TextBlock x:Name="InstalledVersionText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ResolutionSummaryText" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                               Foreground="Gray" FontSize="12" Visibility="Collapsed" />
                                    <TextBlock x:Name="ResolutionWarningText" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                               Foreground="DarkOrange" FontSize="12" Visibility="Collapsed" />
                                </StackPanel>
                                <TextBlock x:Name="RunningVersionLabel" Grid.Row="1" Text="Running" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                    <TextBlock x:Name="RunningVersionText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                    <TextBlock x:Name="InUseText" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                               Foreground="Gray" FontSize="12" Visibility="Collapsed" />
                                </StackPanel>
                                <Button x:Name="RefreshVersionButton" Grid.RowSpan="2" Grid.Column="2" Content="Refresh"
                                        VerticalAlignment="Bottom" Click="RefreshVersionButton_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Audio -->
                <StackPanel x:Name="AudioTab" Spacing="12" Visibility="Collapsed">
                    <ComboBox x:Name="AudioInputComboBox" Header="Input device (Local mode)" Width="440" HorizontalAlignment="Left"
                              PlaceholderText="The radio's USB audio input" DropDownOpened="AudioInputComboBox_DropDownOpened"
                              ToolTipService.ToolTip="The FTX-1's USB audio as a Windows recording device (usually &quot;Microphone (USB Audio Device)&quot;)" />
                    <TextBlock Text="In Remote mode the audio comes from the Pi's stream (port 8532) instead."
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                    <ComboBox x:Name="AudioOutputComboBox" Header="Output device" Width="440" HorizontalAlignment="Left"
                              DropDownOpened="AudioOutputComboBox_DropDownOpened"
                              ToolTipService.ToolTip="Where the radio's audio plays. Picking your speakers here keeps it there even when Windows switches its default output (e.g. to the radio when it's plugged in)." />
                    <TextBlock Text="A change applies on Save, also while connected."
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                    <ComboBox x:Name="TxAudioOutputComboBox" Header="Transmit audio output (Local mode)" Width="440" HorizontalAlignment="Left"
                              DropDownOpened="TxAudioOutputComboBox_DropDownOpened"
                              ToolTipService.ToolTip="The FTX-1's USB audio as a Windows playback device (usually &quot;Speakers (USB Audio Device)&quot;)" />
                    <TextBlock Text="Where an iPad's microphone plays while it holds PTT through the Desktop hub: pick the radio's USB audio. None sends nothing (Windows' default output is never used). In Remote mode it goes to the Pi (port 8533) instead. The rig's MOD SOURCE for the mode has to be USB."
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <!-- C4FM -->
                <StackPanel x:Name="C4fmTab" Spacing="12" Visibility="Collapsed">
                    <CheckBox x:Name="WpsdEnabledCheckBox" Content="Show received callsign (via WPSD)" />
                    <TextBox x:Name="WpsdHostBox" Header="Hotspot address" Width="320" HorizontalAlignment="Left"
                             PlaceholderText="e.g. 192.168.1.50" />
                    <TextBlock Text="While a VFO is in C4FM, shows who's transmitting through your WPSD hotspot and the YSF reflector it's linked to, read from the hotspot's dashboard."
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <!-- APRS (the Mac's APRSSettingsTab). -->
                <StackPanel x:Name="AprsTab" Spacing="12" Visibility="Collapsed">
                    <CheckBox x:Name="AprsEnabledCheckBox" Content="Decode APRS" />
                    <TextBox x:Name="AprsFrequencyBox" Header="Frequency (MHz)" Width="200" HorizontalAlignment="Left"
                             PlaceholderText="144.390" />
                    <NumberBox x:Name="AprsToleranceBox" Header="Tolerance (Hz)" Width="220" HorizontalAlignment="Left"
                               SpinButtonPlacementMode="Inline" SmallChange="500" LargeChange="5000" />
                    <TextBlock Text="Each receiver is decoded while its VFO is within the tolerance of this frequency and audio is on — MAIN and SUB separately, so APRS can sit on either one."
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                    <NumberBox x:Name="AprsMaxStationsBox" Header="Stations to keep" Width="220" HorizontalAlignment="Left"
                               SpinButtonPlacementMode="Inline" SmallChange="100" LargeChange="1000" />
                    <NumberBox x:Name="AprsMaxMessagesBox" Header="Messages to keep" Width="220" HorizontalAlignment="Left"
                               SpinButtonPlacementMode="Inline" SmallChange="100" LargeChange="1000" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="AprsClearHistoryButton" Content="Clear History…" Click="AprsClearHistoryButton_Click" />
                        <TextBlock x:Name="AprsClearNote" VerticalAlignment="Center" Foreground="Gray" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <!-- Station (the Mac's StationSettings). -->
                <StackPanel x:Name="StationTab" Spacing="12" Visibility="Collapsed">
                    <TextBox x:Name="CallsignBox" Header="Callsign" Width="160" HorizontalAlignment="Left"
                             PlaceholderText="e.g. W1AW" MaxLength="12" CharacterCasing="Upper" />
                    <TextBlock Text="Your callsign: {MYCALL} in the CW window's macros. It isn't made clickable in decoded CW."
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                    <TextBox x:Name="GridSquareBox" Header="Grid square" Width="160" HorizontalAlignment="Left"
                             PlaceholderText="e.g. FN31pr" MaxLength="8" />
                    <TextBlock Text="Your Maidenhead locator (4 or 6 characters): {MYGRID} in CW macros. The WebSDR window's KiwiSDR list uses it to show each station's distance and sort nearest first."
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Logbook (the Mac's LogbookSettingsTab, HRD Logbook or Log4OM where
                     it has MacLoggerDX). The status cards follow the fields, unsaved. -->
                <StackPanel x:Name="LogbookTab" Spacing="12" Visibility="Collapsed">
                    <ComboBox x:Name="LogbookComboBox" Header="Logbook" Width="300" HorizontalAlignment="Left"
                              SelectionChanged="LogbookComboBox_SelectionChanged">
                        <ComboBoxItem Content="None" Tag="None" />
                        <ComboBoxItem Content="Ham Radio Deluxe Logbook" Tag="HrdLogbook" />
                        <ComboBoxItem Content="Log4OM" Tag="Log4Om" />
                    </ComboBox>
                    <TextBlock Text="The CW window's Log QSO pane sends QSOs here, and decoded callsigns are colored by whether this log has worked them."
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap" />

                    <StackPanel x:Name="HrdSettingsPanel" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="HrdLogPathBox" Header="Log file" Width="400" HorizontalAlignment="Left"
                                     ToolTipService.ToolTip="HRD's SQLite log (.hrdsql), read only — for worked-before and to confirm a logged QSO arrived" />
                            <Button Content="Browse…" VerticalAlignment="Bottom" Click="BrowseHrdLogButton_Click" />
                            <Button Content="Use HRD's" VerticalAlignment="Bottom" Click="UseHrdLogButton_Click"
                                    ToolTipService.ToolTip="Read the log HRD receives QSOs into" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBox x:Name="HrdHostBox" Header="Send to host" Width="200" HorizontalAlignment="Left" />
                            <NumberBox x:Name="HrdPortBox" Header="UDP port" Width="140" HorizontalAlignment="Left"
                                       Minimum="1" Maximum="65535" ValidationMode="InvalidInputOverwritten" />
                        </StackPanel>
                        <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                                   Text="Leave these empty to use HRD's own ADIF receiver. Turn it on in HRD Logbook: Tools → Configure → QSO Forwarding → &quot;Receive QSO notifications using UDP9/ADIF from other logging programs (eg. WSJT-X)&quot;. HRD fills in your station callsign and looks the call up when a QSO arrives." />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Status" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="12,8">
                                <Grid ColumnSpacing="12" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="HRD Logbook" />
                                    <TextBlock x:Name="HrdRunningText" Grid.Column="1" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Text="Receiving" />
                                    <TextBlock x:Name="HrdReceiverText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Text="Log" />
                                    <TextBlock x:Name="HrdLogText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <Button Grid.RowSpan="3" Grid.Column="2" Content="Refresh" VerticalAlignment="Bottom"
                                            Click="RefreshHrdButton_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="Log4OmSettingsPanel" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="Log4OmLogPathBox" Header="Log file" Width="400" HorizontalAlignment="Left"
                                     ToolTipService.ToolTip="Log4OM's SQLite log (.SQLite), read only — for worked-before and to confirm a logged QSO arrived" />
                            <Button Content="Browse…" VerticalAlignment="Bottom" Click="BrowseLog4OmLogButton_Click" />
                            <Button Content="Use Log4OM's" VerticalAlignment="Bottom" Click="UseLog4OmLogButton_Click"
                                    ToolTipService.ToolTip="Read the log Log4OM has open" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBox x:Name="Log4OmHostBox" Header="Send to host" Width="200" HorizontalAlignment="Left" PlaceholderText="127.0.0.1" />
                            <NumberBox x:Name="Log4OmPortBox" Header="UDP port" Width="140" HorizontalAlignment="Left"
                                       Minimum="1" Maximum="65535" ValidationMode="InvalidInputOverwritten" />
                        </StackPanel>
                        <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                                   Text="Leave these empty to send to Log4OM on this PC. In Log4OM: Settings → Program Configuration → Software Integration → Connections, add a UDP inbound connection of type ADIF_MESSAGE (e.g. port 2236). Log4OM looks the call up when a QSO arrives; the CW window's Lookup button asks it to look one up sooner, through its remote control (UDP 2241, on by default)." />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Status" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="12,8">
                                <Grid ColumnSpacing="12" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Log4OM" />
                                    <TextBlock x:Name="Log4OmRunningText" Grid.Column="1" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Text="Receiving" />
                                    <TextBlock x:Name="Log4OmReceiverText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Text="Lookup" />
                                    <TextBlock x:Name="Log4OmRemoteText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3" Text="Log" />
                                    <TextBlock x:Name="Log4OmLogText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <Button Grid.RowSpan="4" Grid.Column="2" Content="Refresh" VerticalAlignment="Bottom"
                                            Click="RefreshLog4OmButton_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Home Freq: rows added in code, one per HomeBand. -->
                <StackPanel x:Name="HomeTab" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="The FM page's HOME button tunes to the frequency for the band group Main is in (the rig's own HOME channels can't be read over CAT)."
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel x:Name="HomeFieldsPanel" Spacing="8" />
                </StackPanel>

                <!-- Polling -->
                <StackPanel x:Name="PollingTab" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Radio (rigctld)" FontWeight="SemiBold" />
                    <NumberBox x:Name="PollIntervalBox" Header="VFO / meters interval (ms)" Width="220" HorizontalAlignment="Left"
                               SpinButtonPlacementMode="Inline" SmallChange="50" LargeChange="500" />
                    <NumberBox x:Name="SlowPollEveryBox" Header="Menu settings: read every N polls" Width="220" HorizontalAlignment="Left"
                               SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="5" />
                    <TextBlock Text="A shorter interval updates the VFO display and meters faster; reading menu settings more often picks up front-panel changes sooner. Over the Pi link a poll takes about half a second, so an interval below that has no further effect."
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="WPSD hotspot" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <NumberBox x:Name="WpsdCallerBox" Header="Caller lookup every (s)" Width="220" HorizontalAlignment="Left"
                               SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="5" />
                    <NumberBox x:Name="WpsdReflectorBox" Header="Reflector lookup every (s)" Width="220" HorizontalAlignment="Left"
                               SpinButtonPlacementMode="Inline" SmallChange="5" LargeChange="30" />
                    <Button Content="Restore Defaults" Click="RestorePollingDefaults_Click" />
                </StackPanel>

                <!-- Appearance -->
                <StackPanel x:Name="AppearanceTab" Spacing="12" Visibility="Collapsed">
                    <RadioButtons x:Name="ThemeRadioButtons" Header="Theme" MaxColumns="3" />
                    <ComboBox x:Name="ButtonValueColorComboBox" Header="Button value color" Width="200" HorizontalAlignment="Left"
                              ToolTipService.ToolTip="The color of each MENU grid button's current setting" />
                </StackPanel>

                <!-- Hub: the iPad's Desktop hub (Services/Hub/HubServer.cs). The
                     switch applies on Save; the status and clients are live. -->
                <StackPanel x:Name="HubTab" Spacing="12" Visibility="Collapsed">
                    <ToggleSwitch x:Name="HubEnabledSwitch" Header="Allow iPad connections" />
                    <TextBlock Text="Lets the iPad's Desktop hub route connect to this app over Tailscale or the local network (other addresses are refused). The iPad shows this app's state, controls the rig through it and hears its MAIN/SUB audio; transmitting, the memory/APRS lists, Deep Settings values and CW sending from the iPad aren't supported yet."
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="HubPortText" />
                    <TextBlock x:Name="HubStatusText" />
                    <TextBlock x:Name="HubAudioOffText" Visibility="Collapsed" TextWrapping="Wrap"
                               Text="Audio is off on this PC, so the iPad hears nothing. Turn on Audio in the main window (with the rig connected)." />
                    <TextBlock Text="Connected clients" FontWeight="SemiBold" />
                    <TextBlock x:Name="HubNoClientsText" Text="None" Foreground="Gray" />
                    <ListView x:Name="HubClientsList" SelectionMode="None" MaxHeight="140" />
                    <TextBlock Text="Windows Firewall has to allow inbound TCP 8765 for FTX1RemoteWindows.exe. Tailscale's adapter is often a Public network, so allow Public as well as Private when Windows asks (or see the README)."
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <!-- About: version + update check (notify-only). -->
                <StackPanel x:Name="AboutTab" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="FTX1Remote for Windows" FontWeight="SemiBold" FontSize="18" />
                    <TextBlock x:Name="VersionText" />
                    <CheckBox x:Name="CheckAtLaunchCheckBox" Content="Check for updates when the app starts" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CheckForUpdatesButton" Content="Check for Updates" Click="CheckForUpdatesButton_Click" />
                        <ProgressRing x:Name="UpdateProgress" IsActive="False" Width="20" Height="20" />
                        <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="DownloadUpdateButton" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}"
                            Click="DownloadUpdateButton_Click" />
                    <TextBox x:Name="ReleaseNotesBox" Header="What's new" Visibility="Collapsed" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180" />
                    <HyperlinkButton Content="All releases on GitHub" NavigateUri="https://github.com/captobie/ftx1-remote/releases" Padding="0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Save" MinWidth="100" Style="{StaticResource AccentButtonStyle}"
                    Click="SaveButton_Click" />
            <Button Content="Cancel" MinWidth="100" Click="CancelButton_Click">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
            </Button>
        </StackPanel>
    </Grid>
</Window>
