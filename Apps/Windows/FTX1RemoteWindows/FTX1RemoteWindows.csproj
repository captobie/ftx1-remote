<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FTX1RemoteWindows</RootNamespace>
    <!-- Matches the Mac app's version; Settings → About shows it and the
         update check compares it with the GitHub releases that carry a Windows
         zip (combined "v<version>" since 0.9; see Services/UpdateChecker.cs). -->
    <Version>0.10</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!--
      WindowsAppSDKSelfContained's build target hard requires a concrete
      RuntimeIdentifier (win-x64/win-arm64/win-x86) and fails with
      "requires a supported Windows architecture" if none is set, which is
      exactly what happens on a bare "dotnet run"/"dotnet build" with no r
      flag, since those don't set one on their own. Default to the SDK's
      own resolved RID (win-arm64 on this Parallels-on-Apple-Silicon dev
      machine, win-x64 on a typical Intel/AMD one) so plain "dotnet run"
      works without remembering to pass r every time; an explicit "-r
      <rid> self-contained" flag still overrides this, e.g. when cross
      building win-x64 output from this arm64 machine.
    -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <!-- Services/WebSdrAudioTap.cs reads WASAPI capture buffers in place. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Unpackaged for now so `dotnet build`/`dotnet run` work stand-alone
      while the app is scaffolding. Apps/Windows/README.md's plan is
      MSIX-packaged — flip this to Packaged (and add Package.appxmanifest +
      real icon assets + a signing certificate, which Visual Studio
      generates automatically on first packaged build) once there's an
      actual app icon to ship; see the README's "Open items" for why that
      step is deliberately not done blind from the CLI.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\CWNet.onnx" CopyToOutputDirectory="PreserveNewest" />
    <!-- Also set on the window at runtime (MainWindow), since WinUI windows don't pick up the exe icon by themselves. -->
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The APRS map page and its vendored Leaflet 1.9.4 (BSD-2-Clause) — Controls/AprsMapWindow.cs. -->
    <Content Include="Assets\AprsMap\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- DSEG7 Classic 0.46 (SIL OFL 1.1, keshikan/DSEG) for the themes' 7-segment VFO digits — Controls/VfoDigits.cs. -->
    <Content Include="Assets\Fonts\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!--
      Hamlib's official Windows rigctld.exe + the DLLs it loads + its licence
      files (Vendor\hamlib, from Apps/Windows/Tools/fetch-rigctld.ps1), for
      Local mode when no suitable rigctld is installed — Services/RigctldBinary.cs.
      Lands in <output>\hamlib\ for both build and publish. x64 only (Hamlib
      has no ARM64 build; it runs under emulation there).
    -->
    <Content Include="Vendor\hamlib\*" Link="hamlib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Kestrel + WebSockets for the iPad's Desktop hub (Services/Hub/HubServer.cs).
      Part of the shared framework, so self-contained builds carry it.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Runs the CW window's neural decoder (Assets/CWNet.onnx, converted from
      CWKit's Core ML model by Apps/Windows/Tools/cwnet_to_onnx.py). MIT-licensed.
    -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <!--
      Reads HRD Logbook's SQLite log (read-only) for worked-before in the CW
      window — Services/HrdLogbook.cs. MIT-licensed.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <!--
      Audio output (WASAPI) for the Pi's :8532 stream. NAudio.Wasapi rather
      than the NAudio metapackage, which also drags in WinForms/ASIO/MIDI.
      MIT-licensed.
    -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <!--
    An unpackaged "dotnet publish" leaves the app's own FTX1RemoteWindows.pri
    and compiled XAML (*.xbf) out of the publish folder, though the build
    output has them, and the published exe then dies at startup in
    Microsoft.UI.Xaml.dll (0xc000027b) loading MainWindow. Copy them over.
  -->
  <Target Name="CopyXamlResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_AppXamlResources Include="$(OutDir)$(AssemblyName).pri;$(OutDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_AppXamlResources)" DestinationFiles="@(_AppXamlResources->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
