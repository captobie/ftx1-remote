<Window
    x:Class="FTX1RemoteWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Scrolls so a window smaller than the MENU grid needs still reaches everything. -->
    <ScrollViewer>
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Connection bar: mode picker, then either the Pi host (Remote)
             or the rigctld launch settings (Local), then Connect. -->
        <StackPanel Grid.Row="0" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Radio:" VerticalAlignment="Center" />
                <ComboBox x:Name="ConnectionModeComboBox" Width="200"
                          SelectionChanged="ConnectionModeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Remote (Pi over Tailscale)" Tag="Remote" />
                    <ComboBoxItem Content="Local (USB on this PC)" Tag="Local" />
                </ComboBox>
                <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click" />
                <TextBlock x:Name="ConnectionStateText" Text="Disconnected" VerticalAlignment="Center" Foreground="Gray" />
            </StackPanel>

            <StackPanel x:Name="RemoteSettingsPanel" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Pi host:" VerticalAlignment="Center" />
                <TextBox x:Name="PiHostBox" Width="220" PlaceholderText="ftx1-pi (Tailscale MagicDNS name)" />
            </StackPanel>

            <StackPanel x:Name="LocalSettingsPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="rigctld.exe:" VerticalAlignment="Center" />
                <TextBox x:Name="RigctldPathBox" Width="320"
                         PlaceholderText="C:\Program Files\hamlib-w64-4.7\bin\rigctld.exe" />
                <Button x:Name="BrowseRigctldButton" Content="Browse…" Click="BrowseRigctldButton_Click" />
                <TextBlock Text="COM port:" VerticalAlignment="Center" Margin="8,0,0,0" />
                <ComboBox x:Name="ComPortComboBox" Width="110" IsEditable="True" PlaceholderText="COM3"
                          DropDownOpened="ComPortComboBox_DropDownOpened"
                          ToolTipService.ToolTip="The FTX-1's CAT port (the Enhanced COM port of its CP210x pair)" />
                <TextBlock Text="Baud:" VerticalAlignment="Center" Margin="8,0,0,0" />
                <ComboBox x:Name="BaudRateComboBox" Width="110" />
                <!-- Stays enabled while connected: picking another input restarts capture. -->
                <TextBlock Text="Audio in:" VerticalAlignment="Center" Margin="8,0,0,0" />
                <ComboBox x:Name="AudioInputComboBox" Width="280" PlaceholderText="The radio's USB audio input"
                          DropDownOpened="AudioInputComboBox_DropDownOpened"
                          SelectionChanged="AudioInputComboBox_SelectionChanged"
                          ToolTipService.ToolTip="The FTX-1's USB audio as a Windows recording device (usually &quot;Microphone (USB Audio Device)&quot;)" />
            </StackPanel>
        </StackPanel>

        <!-- VFO A/B -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="12">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="VFO A (active)" FontWeight="SemiBold" />
                        <!-- "CH n TAG" while in Memory mode, "VM nn" in the other
                             sub-modes, hidden in VFO mode. -->
                        <TextBlock x:Name="MemoryChannelAText" FontWeight="SemiBold" Foreground="DarkOrange" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock x:Name="FrequencyAText" Text="—" FontSize="28" FontFamily="Consolas" />
                    <!-- Analog meter (Controls/SMeter.cs), added in code; the
                         frequency entry sits below it so Main's and Sub's meters line up. -->
                    <Border x:Name="MainMeterHost" Width="280" HorizontalAlignment="Left" Margin="0,4,0,0" />
                    <StackPanel x:Name="FrequencyEntryPanel" Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="FrequencyEntryBox" Width="140" PlaceholderText="Hz" />
                        <Button x:Name="SetFrequencyButton" Content="Set" Click="SetFrequencyButton_Click" />
                    </StackPanel>
                    <!-- Replaces the frequency entry in Memory mode, like the Mac's
                         MemoryChannelEntryView (the rig rejects "FA" there anyway). -->
                    <StackPanel x:Name="MemoryChannelEntryPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <TextBox x:Name="MemoryChannelEntryBox" Width="100" PlaceholderText="Ch 1-999" />
                        <Button x:Name="SetMemoryChannelButton" Content="Set" Click="SetMemoryChannelButton_Click" />
                        <Button x:Name="MemoryChannelDownButton" Click="MemoryChannelDownButton_Click"
                                AutomationProperties.Name="Previous channel" ToolTipService.ToolTip="Previous channel">
                            <FontIcon Glyph="&#xE70D;" FontSize="12" />
                        </Button>
                        <Button x:Name="MemoryChannelUpButton" Click="MemoryChannelUpButton_Click"
                                AutomationProperties.Name="Next channel" ToolTipService.ToolTip="Next channel">
                            <FontIcon Glyph="&#xE70E;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="SwapVfoButton" Content="⇄" HorizontalAlignment="Center"
                            Click="SwapVfoButton_Click" ToolTipService.ToolTip="Swap Main and Sub (the rig's SV command)" />
                    <!-- Manual override for audio swap tracking; checked while L/R are swapped. -->
                    <ToggleButton x:Name="AudioSwapToggle" HorizontalAlignment="Center" Click="AudioSwapToggle_Click">
                        <FontIcon Glyph="&#xE767;" FontSize="14" />
                    </ToggleButton>
                    <!-- Main's VFO/Memory mode; checked whenever it isn't plain VFO. -->
                    <ToggleButton x:Name="VfoMemoryToggle" Content="V/M" HorizontalAlignment="Center"
                                  Click="VfoMemoryToggle_Click"
                                  ToolTipService.ToolTip="Switch VFO A between VFO and Memory mode (the rig's V/M)" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="VFO B" FontWeight="SemiBold" />
                        <TextBlock x:Name="MemoryChannelBText" FontWeight="SemiBold" Foreground="DarkOrange" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock x:Name="FrequencyBText" Text="—" FontSize="28" FontFamily="Consolas" />
                    <Border x:Name="SubMeterHost" Width="280" HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mode / PTT / power / SWR / band -->
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Spacing="4">
                    <TextBlock Text="Mode" FontWeight="SemiBold" />
                    <ComboBox x:Name="ModeComboBox" Width="120" SelectionChanged="ModeComboBox_SelectionChanged" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Band" FontWeight="SemiBold" />
                    <ComboBox x:Name="BandComboBox" Width="100" SelectionChanged="BandComboBox_SelectionChanged" />
                </StackPanel>

                <!-- Safety cutoff, applies at once; see TransmitGate. -->
                <ToggleSwitch x:Name="TransmitEnabledSwitch" Header="Enable Transmit" OnContent="On" OffContent="Off"
                              Toggled="TransmitEnabledSwitch_Toggled"
                              ToolTipService.ToolTip="When off, PTT (and MOX, antenna tuning and CW MESSAGE playback, once this app has them) is blocked. Switching it off while transmitting unkeys the rig at once." />

                <StackPanel Spacing="4">
                    <TextBlock Text="PTT" FontWeight="SemiBold" />
                    <!-- Momentary: keyed while held, like the Mac/iPad PTT. A Border
                         rather than a Button so its background can show TX
                         state without the Button template's pressed/hover
                         states overriding it. -->
                    <Border x:Name="PttButton" MinWidth="130" Padding="16,8" CornerRadius="8"
                            Background="#40808080"
                            AutomationProperties.Name="Push to talk"
                            PointerPressed="PttButton_PointerPressed"
                            PointerReleased="PttButton_PointerReleased"
                            PointerCanceled="PttButton_PointerReleased"
                            PointerCaptureLost="PttButton_PointerReleased">
                        <TextBlock x:Name="PttText" Text="PTT" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>

                <StackPanel Spacing="4" Width="160">
                    <TextBlock Text="Power level" FontWeight="SemiBold" />
                    <Slider x:Name="PowerSlider" Minimum="0" Maximum="100" ValueChanged="PowerSlider_ValueChanged" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Power out" FontWeight="SemiBold" />
                    <TextBlock x:Name="PowerWattsText" Text="—" FontFamily="Consolas" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="SWR" FontWeight="SemiBold" />
                    <TextBlock x:Name="SwrText" Text="—" FontFamily="Consolas" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--
          Audio (Pi :8532). Main left / Sub right, matching the VFO A/B row
          above (the Mac's audio row is Sub-then-Main because its VFO boxes
          are). SQL is inverted like the Mac's: further right = tighter.
        -->
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ToggleSwitch x:Name="AudioSwitch" Header="Audio" OnContent="On" OffContent="Off"
                                  Toggled="AudioSwitch_Toggled"
                                  ToolTipService.ToolTip="The Pi streams audio to one client at a time. Turn this off to let the Mac have it." />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Out" FontSize="12" />
                        <ComboBox x:Name="AudioOutputComboBox" Width="300"
                                  DropDownOpened="AudioOutputComboBox_DropDownOpened"
                                  SelectionChanged="AudioOutputComboBox_SelectionChanged"
                                  ToolTipService.ToolTip="Where the radio's audio plays. Picking your speakers here keeps it there even when Windows switches its default output (e.g. to the radio when it's plugged in)." />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="AudioStateText" Text="Not connected" Foreground="Gray" />
                        <TextBlock x:Name="AudioLevelsText" Text="" FontFamily="Consolas" FontSize="12" Foreground="Gray" />
                    </StackPanel>
                </StackPanel>

                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="MAIN" FontWeight="SemiBold" VerticalAlignment="Center" Width="40" />
                        <ToggleButton x:Name="MainMuteToggle" Content="Mute" Click="MainMuteToggle_Click" VerticalAlignment="Center" />
                        <StackPanel Width="140">
                            <TextBlock Text="VOL" FontSize="12" />
                            <Slider x:Name="MainVolumeSlider" Minimum="0" Maximum="1" StepFrequency="0.01"
                                    ValueChanged="MainVolumeSlider_ValueChanged" />
                        </StackPanel>
                        <StackPanel Width="140">
                            <TextBlock Text="SQL" FontSize="12" />
                            <Slider x:Name="MainSquelchSlider" Minimum="0" Maximum="0.05" StepFrequency="0.001"
                                    ValueChanged="MainSquelchSlider_ValueChanged" IsThumbToolTipEnabled="False" />
                        </StackPanel>
                        <Ellipse x:Name="MainSquelchLed" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center"
                                 ToolTipService.ToolTip="Squelch open" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="SUB" FontWeight="SemiBold" VerticalAlignment="Center" Width="40" />
                        <ToggleButton x:Name="SubMuteToggle" Content="Mute" Click="SubMuteToggle_Click" VerticalAlignment="Center" />
                        <StackPanel Width="140">
                            <TextBlock Text="VOL" FontSize="12" />
                            <Slider x:Name="SubVolumeSlider" Minimum="0" Maximum="1" StepFrequency="0.01"
                                    ValueChanged="SubVolumeSlider_ValueChanged" />
                        </StackPanel>
                        <StackPanel Width="140">
                            <TextBlock Text="SQL" FontSize="12" />
                            <Slider x:Name="SubSquelchSlider" Minimum="0" Maximum="0.05" StepFrequency="0.001"
                                    ValueChanged="SubSquelchSlider_ValueChanged" IsThumbToolTipEnabled="False" />
                        </StackPanel>
                        <Ellipse x:Name="SubSquelchLed" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center"
                                 ToolTipService.ToolTip="Squelch open" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- MENU grid (Controls/MenuGrid.cs), added in code. -->
        <Border Grid.Row="4" x:Name="MenuGridHost" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="12" />

        <TextBlock Grid.Row="5" x:Name="StatusText" Text="" Foreground="Firebrick" TextWrapping="Wrap" VerticalAlignment="Bottom" />
    </Grid>
    </ScrollViewer>
</Window>
