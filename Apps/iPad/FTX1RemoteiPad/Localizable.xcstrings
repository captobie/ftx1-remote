    "piDirect.demoModeASimulated" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demomodus: ein simulierter FTX-1 – eine CW-Bake auf 14.047.5 MHz, APRS auf 144.390 MHz und ein 2-m-Relais, das alle 45 s auf Speicherkanal 2 auftastet. Entsperren, um PTT und CW-Senden auszuprobieren; nichts verlässt das iPad. Hier geänderte Einstellungen werden beim Beenden der Demo verworfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo Mode: a simulated FTX-1 — a CW beacon on 14.047.5 MHz, APRS on 144.390 MHz, a 2 m repeater that comes up every 45 s on memory channel 2. Unlock to try PTT and CW sending; nothing leaves the iPad. Settings changed here are thrown away on Exit Demo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo demo: un FTX-1 simulado, con una baliza CW en 14.047.5 MHz, APRS en 144.390 MHz y un repetidor de 2 m que se activa cada 45 s en el canal de memoria 2. Desbloquear para probar PTT y el envío de CW; nada sale del iPad. Los ajustes cambiados aquí se descartan al salir de la demo."
          }
        }
      }
    },
    "piDirect.directToRigctldOn" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkt zu rigctld auf dem Pi, ohne Desktop-Hub. Zum Senden entsperren (PTT, MOX, ANT TUNE); PTT halten, um über das Mikrofon des iPad zu sprechen. Audio folgt dem Tauschen; den Lautsprecher-Knopf verwenden, wenn MAIN- und SUB-Audio vertauscht sind. Menüwerte werden etwa alle 10 s aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct to rigctld on the Pi, no desktop hub. Unlock to transmit (PTT, MOX, ANT TUNE); hold PTT to talk through the iPad's microphone. Audio follows swaps; use the speaker button if MAIN and SUB audio are reversed. Menu values refresh every ~10 s."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Directo a rigctld en el Pi, sin hub de escritorio. Desbloquear para transmitir (PTT, MOX, ANT TUNE); mantener PTT pulsado para hablar por el micrófono del iPad. El audio sigue los intercambios; usar el botón del altavoz si el audio de MAIN y SUB está invertido. Los valores del menú se actualizan cada ~10 s."
          }
        }
      }
    },
