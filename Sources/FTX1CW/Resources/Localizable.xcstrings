    "cwReceiverControls.neuralAModelTrained" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuronal: ein mit simuliertem CW trainiertes Modell, am besten bei schwachen und verrauschten Signalen; der Text läuft etwa 3½ s hinterher. Klassisch: Tonschwelle und Timing-Regeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neural: a model trained on simulated CW, best on weak and noisy signals; text runs about 3½ s behind. Classic: tone threshold and timing rules."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuronal: un modelo entrenado con CW simulado, mejor con señales débiles y ruidosas; el texto va unos 3½ s por detrás. Clásico: umbral de tono y reglas de temporización."
          }
        }
      }
    },
