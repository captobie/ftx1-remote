    "cwReceiverControls.turnOffAutoTune %lld" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-Abstimmung ausschalten und den CW-Pitch des Geräts verwenden, %lld Hz – dort klingt ein auf Schwebungsnull abgestimmtes Signal"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off auto-tune and use the rig's CW pitch, %lld Hz — where a zero-beat signal sounds"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivar la sintonía automática y usar el tono CW del equipo, %lld Hz, donde suena una señal en batido cero"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver l'accord automatique et utiliser la tonalité CW du poste, %lld Hz, là où sonne un signal au battement nul"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva la sintonia automatica e usa il tono CW dell'apparato, %lld Hz, dove suona un segnale a battimento zero"
          }
        }
      }
    },
