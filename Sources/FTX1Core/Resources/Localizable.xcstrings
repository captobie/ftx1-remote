    "—" : {
      "comment" : "A placeholder text for a band picker.",
      "isCommentAutoGenerated" : true
    },
    "%lld" : {
      "comment" : "A stepper that increments or decrements a value by a given step. The first argument is the value, optionally suffixed with a unit. The second argument is the value of the step.",
      "isCommentAutoGenerated" : true
    },
    "%lld %@" : {
      "comment" : "A label that shows the current value and unit, or just the value if no unit is provided.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld %2$@"
          }
        }
      }
    },
    "%lld Hz" : {
      "comment" : "A label displaying the frequency in Hz for a given filter width.",
      "isCommentAutoGenerated" : true
    },
    "%lld ms" : {
      "comment" : "A stepper that lets the user adjust the delay between sending BREAK-IN messages.",
      "isCommentAutoGenerated" : true
    },
    "%lld WPM" : {
      "comment" : "The label for the stepper that lets the user adjust the speed of their CW transmission.",
      "isCommentAutoGenerated" : true
    },
