    "localSDR.waterfall.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken zum Abstimmen, Ziehen zum Verschieben, Scrollen zum Abstimmen in Schritten. Kanten des Durchlassbereichs ziehen für die Breite, seine Mitte zum Abstimmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
