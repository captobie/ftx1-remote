          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clic para sintonizar, arrastrar para desplazar, rueda para sintonizar por pasos. Arrastrar los bordes de la banda de paso para su ancho, su centro para sintonizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
