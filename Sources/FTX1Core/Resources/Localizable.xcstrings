            "value" : "Am Port von rigctld lauscht nichts: rigctld läuft nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is listening on rigctld's port: rigctld isn't running."
          }
        },
