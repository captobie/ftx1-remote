    "cwKeyingDriver.rfFeedbackDetectedThe" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HF-Rückkopplung erkannt: Der Tasteneingang folgte den eigenen Aussendungen des Geräts, daher wurde das Tasten gestoppt und die Taste entschärft. Ferrit an der Tastenleitung prüfen, dann neu scharf schalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RF feedback detected: the key input was following the rig's own transmissions, so keying stopped and the key was disarmed. Check the key lead's ferrite, then re-arm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retorno de RF detectado: la entrada de la llave seguía las propias transmisiones del equipo, así que se detuvo la manipulación y se desarmó la llave. Revisar la ferrita del cable de la llave y volver a armar."
          }
        }
      }
    },
